{
  "compilerOptions": {
    "target":                  "ES2022",
    "lib":                     ["ES2022"],
    "module":                  "ES2022",
    "moduleResolution":        "Bundler",
    "strict":                  true,
    "noImplicitAny":           true,
    "esModuleInterop":         true,
    "resolveJsonModule":       true,
    "isolatedModules":         true,
    "skipLibCheck":            true,
    "types":                   ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*", "CANONICAL.json"]
}
